CAMERA_INDEX=1
COOLDOWN_SEGUNDOS=60
# Confirmação contínua por pessoa, em segundos
EPI_CONFIRMACAO_SEGUNDOS=3
QUEDA_CONFIRMACAO_SEGUNDOS=2
# Modelo adicional de óculos; o modelo principal continua atendendo os demais EPIs.
OCULOS_MODEL_PATH=runs/detect/treinamento_epi-2/weights/best.pt
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
EMAIL_REMETENTE=seu-email@example.com
EMAIL_DESTINATARIO=destino@example.com
SMTP_SENHA=sua-senha-de-app
# Seleção automática de CUDA, com alternativa CPU. FP16 requer validação própria.
VIGIAAI_DEVICE=auto
VIGIAAI_FP16=0
VIGIAAI_IMGSZ=640
# Linha horizontal do chão calibrada nesta câmera, y/altura; vazio = sem referência.
QUEDA_CHAO_Y=
# Preservam o comportamento anterior; use 0 para desativar.
NOTIFICACOES_ATIVAS=1
SALVAR_IMAGEM_OCORRENCIA=1
# Em testes, impede envio de SMTP mesmo se houver credenciais locais.
VIGIAAI_TESTE=0
# Central 2.1: uploads temporários; codecs disponíveis são verificados ao enviar.
VIGIAAI_UPLOAD_MAX_MB=512
VIGIAAI_MAX_VIDEO_SEGUNDOS=14400
VIGIAAI_UPLOAD_TTL_SEGUNDOS=86400
VIGIAAI_MAX_CAMERAS=3
# Opcional: pasta privada para uploads. Vazio usa o diretório temporário do sistema.
# VIGIAAI_MEDIA_DIR=C:/pasta-privada/VigiaAI
